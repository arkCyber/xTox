@{xtox_prefix} = /usr /usr/local

# Allow to read & write into mounted media, etc.
# for convenient sending & receiving of files.
@{xtox_additional_rw_dirs} = /mnt /media

# Create /etc/apparmor.d/tunables/usr.bin.xtox.d/local file to append values as
# needed, such as:
# @{xtox_prefix} += @{HOME}/opt/xtox
# @{xtox_additional_rw_dirs} = /data/nfs_storage
#include <tunables/usr.bin.xtox.d/>

